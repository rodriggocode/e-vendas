# Copie para .env e preencha com os valores reais. O .env nunca é versionado.
PORT=9090

# Postgres (Supabase ou local). Com o pooler transacional do Supabase use a
# porta 6543 e o usuário postgres.<ref>.
DATABASE_URL=postgres://usuario:senha@host:5432/loja?sslmode=disable

# Rate limit de POST /api/v1/auth/register (S1).
# 0 ou negativo derruba o boot (falha rápida, nunca "desliga silenciosamente").
RATE_LIMIT_IP_PER_MIN=10
RATE_LIMIT_IP_BURST=5
RATE_LIMIT_EMAIL_PER_MIN=5
RATE_LIMIT_EMAIL_BURST=3

# CORS fail-closed: lista vazia nega qualquer origem (o site é same-origin).
CORS_ORIGINS=http://localhost:8080

# CIDRs dos proxies confiáveis, para honrar X-Forwarded-For. Vazio = ignorar
# XFF sempre (o peer é tratado como o cliente).
TRUSTED_PROXIES=
