      "versionNonce": 905005354,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1732440000000,
      "link": null,
      "locked": false,
      "text": "1. Router recebe HTTP e aplica middlewares (auth, logging, recovery).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Router recebe HTTP e aplica middlewares (auth, logging, recovery).",
      "lineHeight": 1.25
    },
    {
      "id": "note3",
      "type": "text",
      "x": 80,
      "y": 735,
      "width": 400,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
