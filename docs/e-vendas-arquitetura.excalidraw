      "locked": false,
      "text": "Fluxo típico de uma request:",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fluxo típico de uma request:",
