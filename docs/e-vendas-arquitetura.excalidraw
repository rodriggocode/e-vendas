      "versionNonce": 245938495,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1732440000000,
      "link": null,
      "locked": false,
      "text": "3. UseCase aplica regras de negócio e orquestra repositórios + domain.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. UseCase aplica regras de negócio e orquestra repositórios + domain.",
      "lineHeight": 1.25
    },
    {
