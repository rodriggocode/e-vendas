      "isDeleted": false,
      "boundElements": null,
      "updated": 1732440000000,
      "link": null,
      "locked": false,
      "text": "4. Repository executa SQL no Postgres via pgx (pool).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Repository executa SQL no Postgres via pgx (pool).",
