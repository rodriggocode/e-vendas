      "version": 1,
      "versionNonce": 833223567,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1732440000000,
      "link": null,
      "locked": false,
      "text": "2. Handler valida entrada (JSON) e chama o UseCase correspondente.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Handler valida entrada (JSON) e chama o UseCase correspondente.",
      "lineHeight": 1.25
    },
    {
      "id": "note4",
      "type": "text",
      "x": 80,
      "y": 755,
      "width": 400,
      "height": 20,
      "angle": 0,
